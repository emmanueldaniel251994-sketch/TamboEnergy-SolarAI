# Copy this file to .env and replace the API key with the one shown once
# when a SolarAI device is registered or its key is rotated.
DEVICE_API_KEY=tambo_dev_replace_me
SOLARAI_API_URL=http://127.0.0.1:8000

# The simulator automatically signs each request with HMAC-SHA256 using
# DEVICE_API_KEY and sends timestamp + nonce replay-protection headers.
