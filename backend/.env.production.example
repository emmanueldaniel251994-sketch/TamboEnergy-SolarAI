APP_ENV=production
APP_VERSION=1.0.0
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=tamboenergy-solarai
JWT_AUDIENCE=solarai-users
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/solarai
CORS_ORIGINS=https://your-frontend.example.com
ALLOWED_HOSTS=api.your-domain.example.com
DEVICE_REQUEST_SIGNING_REQUIRED=true
DEVICE_REQUEST_MAX_SKEW_SECONDS=300
DEVICE_RATE_LIMIT_PER_MINUTE=30
DEVICE_NONCE_RETENTION_HOURS=24
