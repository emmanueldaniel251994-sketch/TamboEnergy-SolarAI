# Application
APP_ENV=development
APP_VERSION=1.0.0

# Generate a long random value for production (32+ characters).
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=tamboenergy-solarai
JWT_AUDIENCE=solarai-users

# Local development
DATABASE_URL=sqlite:///./tamboenergy_solarai.db

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Device ingestion security. Production must enable request signing.
DEVICE_REQUEST_SIGNING_REQUIRED=false
DEVICE_REQUEST_MAX_SKEW_SECONDS=300
DEVICE_RATE_LIMIT_PER_MINUTE=30
DEVICE_NONCE_RETENTION_HOURS=24

# Production example:
# APP_ENV=production
# APP_VERSION=1.0.0
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/solarai
# CORS_ORIGINS=https://your-frontend.example.com
# ALLOWED_HOSTS=api.your-domain.example.com
# DEVICE_REQUEST_SIGNING_REQUIRED=true
