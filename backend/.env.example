# Application
APP_ENV=development

# Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local development
DATABASE_URL=sqlite:///./tamboenergy_solarai.db

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/solarai
# CORS_ORIGINS=https://your-frontend.example.com
